# Site Caddy de l'app Djomy pour Shopify.
#
# À copier une fois sur le serveur, dans le dossier des sites importés par
# le Caddy partagé (/opt/fleethub/deploy/sites/), puis recharger Caddy.
# L'app est jointe par le réseau Docker `edge` (cf. docker-compose.yml).

shopify-plugin.ousmanebellasarl.com {
	encode gzip
	reverse_proxy djomy-shopify:3000
}
