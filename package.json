{
  "name": "djomy-shopify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extension de paiement mobile Djomy pour Shopify (Orange Money, MTN MoMo, Kulu, carte).",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "start": "remix-serve ./build/server/index.js",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sandbox": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "setup": "prisma generate && prisma migrate deploy",
    "capture:webhook": "bash verification/capture-webhook.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-remix": "^3.7.0",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "isbot": "^5.1.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.2",
    "@shopify/cli": "^3.75.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
