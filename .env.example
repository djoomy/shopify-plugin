# Copier en .env et renseigner. Ne jamais versionner le .env.

NODE_ENV=development

# --- Shopify (Partner Dashboard > votre app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://votre-tunnel.trycloudflare.com
SCOPES=write_orders,read_orders

# --- Base de données ---
DATABASE_URL=postgresql://djomy:djomy@localhost:5432/djomy

# --- Djomy (espace marchand > espace développeur) ---
# URL de production à obtenir auprès de Djomy (cf. question Q2 du plan).
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
DJOMY_COUNTRY_CODE=GN
DJOMY_TIMEOUT_MS=15000

# --- Chiffrement des secrets marchands stockés en base ---
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=
